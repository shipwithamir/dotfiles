#!/usr/bin/env bash

# Deps: curl, jq, xclip (or wl-paste on Wayland), notify-send + notification daemon (dunst)
for cmd in curl jq notify-send; do
    command -v "$cmd" >/dev/null 2>&1 || { notify-send -h string:bgcolor:#bf616a -t 3000 "Missing dependency: $cmd."; exit 1; }
done

if [ -n "$1" ]; then
    word="$1"
else
    # Primary selection first (highlight), then clipboard (Ctrl+C) fallback
    word=$(xclip -o -selection primary 2>/dev/null || xclip -o -selection clipboard 2>/dev/null || wl-paste 2>/dev/null || true)
fi

# Trim leading/trailing whitespace and newlines, keep only first line/word
word=$(printf '%s' "$word" | head -n 1 | xargs 2>/dev/null || printf '%s' "$word")
# Take first word only (avoid sentences breaking the URL)
word=${word%% *}

# Check for empty word or special characters
[[ -z "$word" || "$word" =~ [\/] ]] && notify-send -h string:bgcolor:#bf616a -t 3000 "Invalid input." && exit 0

# URL-encode the word (handles spaces etc.)
enc_word=$(jq -rn --arg w "$word" '$w|@uri')

query=$(curl -sS -f --connect-timeout 5 --max-time 10 --retry 1 "https://freedictionaryapi.com/api/v1/entries/en/$enc_word")
curl_exit=$?

# Check for connection error
[ $curl_exit -ne 0 ] && notify-send -h string:bgcolor:#bf616a -t 3000 "Connection error." && exit 1

# Check for invalid word response (new API returns 200 with empty entries array)
if [[ "$query" == *"No Definitions Found"* ]] || echo "$query" | jq -e '.entries | length == 0' >/dev/null 2>&1; then
    notify-send -h string:bgcolor:#bf616a -t 3000 "Invalid word." && exit 0
fi

# Show only first 3 definitions
def=$(echo "$query" | jq -r '[.entries[] | {pos: .partOfSpeech, def: .senses[].definition}] | .[:3].[] | "\n\(.pos). \(.def)"')

# Requires a notification daemon to be installed
notify-send -t 60000 "$word -" "$def"


### MORE OPTIONS :)

# Show first definition for each part of speech
# def=$(echo "$query" | jq -r '.entries[] | "\(.partOfSpeech): \(.senses[0].definition)\n"')

# Show all definitions
# def=$(echo "$query" | jq -r '.entries[] | "\n\(.partOfSpeech). \(.senses[].definition)"')

